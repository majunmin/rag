  <diagram id="rag-flow" name="03 检索与问答">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1160" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="chat-request" value="&lt;b&gt;1 · ChatService&lt;/b&gt;&lt;br&gt;单轮问题 / 多轮对话&lt;br&gt;多轮读取 conversation 历史&lt;br&gt;默认最多 20 条历史消息" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#172b4d;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;shadow=0;align=center;verticalAlign=middle;" vertex="1" parent="1" data-model-id="chat-request" data-kind="gateway" data-properties="{&quot;scope&quot;:&quot;current implementation&quot;}" data-source-properties="{&quot;scope&quot;:&quot;current implementation&quot;}" data-source-label="&lt;b&gt;1 · ChatService&lt;/b&gt;&lt;br&gt;单轮问题 / 多轮对话&lt;br&gt;多轮读取 conversation 历史&lt;br&gt;默认最多 20 条历史消息" data-provenance="{&quot;path&quot;:&quot;rag-chat/src/main/java/com/majm/rag/chat/application/ChatService.java&quot;}">
          <mxGeometry x="50" y="200" width="350" height="140" as="geometry" />
        </mxCell>
        <mxCell id="rewrite-query" value="&lt;b&gt;2 · 查询改写&lt;/b&gt;&lt;br&gt;指代消解 → HyDE 假设文档&lt;br&gt;可配置 Multi-Query 扩展&lt;br&gt;整体超时 3 秒 → 回退原问题" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#172b4d;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;shadow=0;align=center;verticalAlign=middle;" vertex="1" parent="1" data-model-id="rewrite-query" data-kind="service" data-properties="{&quot;scope&quot;:&quot;current implementation&quot;}" data-source-properties="{&quot;scope&quot;:&quot;current implementation&quot;}" data-source-label="&lt;b&gt;2 · 查询改写&lt;/b&gt;&lt;br&gt;指代消解 → HyDE 假设文档&lt;br&gt;可配置 Multi-Query 扩展&lt;br&gt;整体超时 3 秒 → 回退原问题" data-provenance="{&quot;path&quot;:&quot;rag-retrieval/src/main/java/com/majm/rag/retrieval/rewrite/QueryRewriteService.java&quot;}">
          <mxGeometry x="530" y="200" width="350" height="140" as="geometry" />
        </mxCell>
        <mxCell id="vector-recall" value="&lt;b&gt;3 · Embedding + 向量召回&lt;/b&gt;&lt;br&gt;text-embedding-v3 → 相似度查询&lt;br&gt;metadata 限定 knowledge_base_id&lt;br&gt;默认候选 20；多查询可用 RRF 融合" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#172b4d;fontFamily=Helvetica;fontSize=16;spacing=12;strokeWidth=1.5;shadow=0;align=center;verticalAlign=middle;" vertex="1" parent="1" data-model-id="vector-recall" data-kind="service" data-properties="{&quot;scope&quot;:&quot;current implementation&quot;}" data-source-properties="{&quot;scope&quot;:&quot;current implementation&quot;}" data-source-label="&lt;b&gt;3 · Embedding + 向量召回&lt;/b&gt;&lt;br&gt;text-embedding-v3 → 相似度查询&lt;br&gt;metadata 限定 knowledge_base_id&lt;br&gt;默认候选 20；多查询可用 RRF 融合" data-provenance="{&quot;path&quot;:&quot;rag-retrieval/src/main/java/com/majm/rag/retrieval/application/RetrievalService.java&quot;}">
          <mxGeometry x="1010" y="200" width="350" height="140" as="geometry" />
        </mxCell>
        <mxCell id="search-api" value="&lt;b&gt;独立检索 API&lt;/b&gt;&lt;br&gt;POST .../{kbId}/search&lt;br&gt;直接调用 RetrievalService" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#172b4d;fontFamily=Helvetica;fontSize=16;spacing=12;strokeWidth=1.5;shadow=0;align=center;verticalAlign=middle;" vertex="1" parent="1" data-model-id="search-api" data-kind="gateway" data-properties="{&quot;scope&quot;:&quot;current implementation&quot;}" data-source-properties="{&quot;scope&quot;:&quot;current implementation&quot;}" data-source-label="&lt;b&gt;独立检索 API&lt;/b&gt;&lt;br&gt;POST .../{kbId}/search&lt;br&gt;直接调用 RetrievalService" data-provenance="{&quot;path&quot;:&quot;rag-retrieval/src/main/java/com/majm/rag/retrieval/api/RetrievalController.java&quot;}">
