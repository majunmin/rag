        <mxCell id="filter-mmr" value="&lt;b&gt;5 · 阈值过滤 + MMR&lt;/b&gt;&lt;br&gt;阈值默认关闭&lt;br&gt;MMR 默认启用 · 抑制相似片段&lt;br&gt;得到最终 topK 上下文" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#172b4d;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;shadow=0;align=center;verticalAlign=middle;" vertex="1" parent="1" data-model-id="filter-mmr" data-kind="service" data-properties="{&quot;scope&quot;:&quot;current implementation&quot;}" data-source-properties="{&quot;scope&quot;:&quot;current implementation&quot;}" data-source-label="&lt;b&gt;5 · 阈值过滤 + MMR&lt;/b&gt;&lt;br&gt;阈值默认关闭&lt;br&gt;MMR 默认启用 · 抑制相似片段&lt;br&gt;得到最终 topK 上下文" data-provenance="{&quot;path&quot;:&quot;rag-retrieval/src/main/java/com/majm/rag/retrieval/application/RetrievalService.java&quot;}">
          <mxGeometry x="530" y="490" width="350" height="140" as="geometry" />
        </mxCell>
        <mxCell id="context" value="&lt;b&gt;6 · 组装本次上下文&lt;/b&gt;&lt;br&gt;选中 chunk 文本 + metadata&lt;br&gt;组成 Prompt 与 context 事件&lt;br&gt;空上下文时提示模型说明不足" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#172b4d;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;shadow=0;align=center;verticalAlign=middle;" vertex="1" parent="1" data-model-id="context" data-kind="gateway" data-properties="{&quot;scope&quot;:&quot;current implementation&quot;}" data-source-properties="{&quot;scope&quot;:&quot;current implementation&quot;}" data-source-label="&lt;b&gt;6 · 组装本次上下文&lt;/b&gt;&lt;br&gt;选中 chunk 文本 + metadata&lt;br&gt;组成 Prompt 与 context 事件&lt;br&gt;空上下文时提示模型说明不足" data-provenance="{&quot;path&quot;:&quot;rag-chat/src/main/java/com/majm/rag/chat/application/ChatService.java&quot;}">
