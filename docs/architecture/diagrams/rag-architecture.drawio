        <mxCell id="rerank" value="&lt;b&gt;4 · Rerank 重排&lt;/b&gt;&lt;br&gt;默认 gte-rerank-v2&lt;br&gt;使用问题意图为候选重新评分&lt;br&gt;关闭 / 失败时保留召回顺序" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#172b4d;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;shadow=0;align=center;verticalAlign=middle;" vertex="1" parent="1" data-model-id="rerank" data-kind="service" data-properties="{&quot;scope&quot;:&quot;current implementation&quot;}" data-source-properties="{&quot;scope&quot;:&quot;current implementation&quot;}" data-source-label="&lt;b&gt;4 · Rerank 重排&lt;/b&gt;&lt;br&gt;默认 gte-rerank-v2&lt;br&gt;使用问题意图为候选重新评分&lt;br&gt;关闭 / 失败时保留召回顺序" data-provenance="{&quot;path&quot;:&quot;rag-retrieval/src/main/java/com/majm/rag/retrieval/application/RetrievalService.java&quot;}">
          <mxGeometry x="1010" y="490" width="350" height="140" as="geometry" />
