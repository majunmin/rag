# Auto-detect text vs binary; normalize line endings to LF on commit
* text=auto eol=lf

# Explicit overrides for known text formats
*.java     text eol=lf diff=java
*.kt       text eol=lf
*.xml      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.sql      text eol=lf
*.sh       text eol=lf

# Windows-only batch files keep CRLF
*.bat      text eol=crlf
*.cmd      text eol=crlf
mvnw.cmd   text eol=crlf

# Binary blobs that must not be touched
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.zip      binary
*.gz       binary
*.tar      binary

# Exclude build / generated stuff from `git diff` and language stats
target/    linguist-generated
docs/      linguist-documentation
